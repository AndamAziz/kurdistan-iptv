<?xml version="1.0" encoding="utf-8"?>
<!-- Only the GitHub / Uptodown build (the "direct" flavour) gets this file.
     It lets that build hand its own downloaded update to Android's installer.
     The Google Play build never has it - Play refuses the permission and
     updates the app itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application>
        <!-- Movies Online: VidAPI's web player, full screen, inside the app.
             Only this build has it; the page asks Android whether it is here. -->
        <activity
            android:name=".EmbedActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|layoutDirection|uiMode"/>
    </application>
</manifest>
