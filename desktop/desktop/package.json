{
  "name": "kurdistan-iptv",
  "version": "1.0.0",
  "description": "KURDISTAN IPTV for Windows",
  "author": "Andam Aziz",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "page": "node copy-page.js",
    "start": "npm run page && electron .",
    "dist": "npm run page && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uk.andam.kurdistaniptv",
    "productName": "KURDISTAN IPTV",
    "copyright": "Andam Aziz",
    "directories": { "output": "out", "buildResources": "build" },
    "files": [
      "main.js",
      "preload.js",
      "proxy.js",
      "player.js",
      "page/**",
      "build/icon.png"
    ],
    "extraResources": [
      { "from": "mpv", "to": "mpv", "filter": ["**/*"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "KURDISTAN-IPTV-Setup-${env.KIPTV_BUILD}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KURDISTAN IPTV",
      "deleteAppDataOnUninstall": false
    }
  }
}
